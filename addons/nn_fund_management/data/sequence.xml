<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Incoming Fund Sequence -->
        <record id="seq_incoming_fund" model="ir.sequence">
            <field name="name">Incoming Fund Sequence</field>
            <field name="code">incoming.fund.sequence</field>
            <field name="prefix">INC/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Fund Allocation Sequence -->
        <record id="seq_fund_allocation" model="ir.sequence">
            <field name="name">Fund Allocation Sequence</field>
            <field name="code">fund.allocation.sequence</field>
            <field name="prefix">ALC/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Fund Requisition Sequence -->
        <record id="seq_fund_requisition" model="ir.sequence">
            <field name="name">Fund Requisition Sequence</field>
            <field name="code">fund.requisition.sequence</field>
            <field name="prefix">REQ/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Fund Transfer Sequence -->
        <record id="seq_fund_transfer" model="ir.sequence">
            <field name="name">Fund Transfer Sequence</field>
            <field name="code">fund.transfer.sequence</field>
            <field name="prefix">TRF/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Fund Bill Sequence -->
        <record id="seq_fund_bill" model="ir.sequence">
            <field name="name">Fund Bill Sequence</field>
            <field name="code">fund.bill.sequence</field>
            <field name="prefix">BILL/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
